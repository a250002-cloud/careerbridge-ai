# ─────────────────────────────────────────────────────────────────────────────
# CareerBridge AI — Environment Variables
# Copy this file to .env, fill in your real values, and NEVER commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── Flask core ────────────────────────────────────────────────────────────────
FLASK_APP=app.py
FLASK_ENV=production

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_64_CHAR_HEX_STRING

# ── Database ──────────────────────────────────────────────────────────────────
# Option A – full connection string (any platform):
#   DATABASE_URL=mysql+pymysql://user:password@host:3306/careerbridge
#
# Option B – Railway MySQL plugin (auto-injected, do not set manually):
#   MYSQL_URL=mysql://user:password@host:3306/railway
#
# Option C – AWS Elastic Beanstalk RDS (auto-injected, do not set manually):
#   RDS_HOSTNAME=xxx.rds.amazonaws.com
#   RDS_PORT=3306
#   RDS_DB_NAME=careerbridge
#   RDS_USERNAME=admin
#   RDS_PASSWORD=REPLACE_WITH_RDS_PASSWORD

DATABASE_URL=mysql+pymysql://root:REPLACE_WITH_PASSWORD@localhost:3306/careerbridge

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Set to "stub" for offline/free mode (fully functional with deterministic replies)
# Set to "openai" to use the real OpenAI API
LLM_PROVIDER=stub
LLM_API_KEY=REPLACE_WITH_OPENAI_API_KEY
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=1024
LLM_MONTHLY_COST_CAP_USD=20.0

# ── File storage ──────────────────────────────────────────────────────────────
# On Railway / EB use /tmp paths (ephemeral); use persistent volume for permanent storage
UPLOAD_FOLDER=/tmp/uploads
GENERATED_FOLDER=/tmp/generated_resumes
MAX_CONTENT_LENGTH=5242880

# ── Model / KB versions ───────────────────────────────────────────────────────
MODEL_VERSION=v0.1-kb-baseline
KB_VERSION=v0.1
FEATURE_VERSION=v0.1

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATELIMIT_DEFAULT=200 per day;50 per hour
RATELIMIT_UPLOAD=10 per hour
RATELIMIT_CHAT=60 per hour
